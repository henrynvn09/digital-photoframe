[Unit]
Description=MagicMirror Client (Raspberry Pi)
After=graphical.target network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=600

[Service]
Type=simple
User=__USER__
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/__USER__/.Xauthority"
Environment="XDG_RUNTIME_DIR=/run/user/__UID__"
WorkingDirectory=__INSTALL_DIR__
ExecStartPre=/bin/bash __INSTALL_DIR__/check_server.sh 10 5
ExecStartPre=/usr/bin/vcgencmd display_power 1
ExecStart=/bin/bash __INSTALL_DIR__/mm.sh
Restart=on-failure
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magicmirror-client

[Install]
WantedBy=graphical.target
