[Unit]
Description=PIR Motion Sensor Display Control
After=magicmirror-client.service
BindsTo=magicmirror-client.service
PartOf=magicmirror-client.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__/pir-control-display
ExecStart=/usr/bin/python3 __INSTALL_DIR__/pir-control-display/pir.py
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magicmirror-pir

[Install]
WantedBy=multi-user.target
