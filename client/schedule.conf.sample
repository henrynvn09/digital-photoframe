# MagicMirror Schedule Configuration
# This file defines when MagicMirror should be running
# Format: DAYRANGE=HH:MM-HH:MM (ON_TIME-OFF_TIME)
# Times are in 24-hour format

# Debug mode - set to 'true' for detailed diagnostic logs
# WARNING: Debug logs can be very verbose. Use only for troubleshooting.
# After fixing issues, set back to 'false' to reduce log volume.
DEBUG=false

# Monday through Friday schedule (ON_TIME-OFF_TIME)
MONDAY_FRIDAY=16:00-20:45

# Saturday and Sunday schedule (ON_TIME-OFF_TIME)
SATURDAY_SUNDAY=08:00-20:45

# Notes:
# - After changing this file, restart the service: sudo systemctl restart digitalframe.service
# - Valid times: 00:00 to 23:59
# - Format must be HH:MM-HH:MM (with dash separator, no spaces)
# - Midnight crossover NOT supported (e.g., 20:00-08:00 will not work)
# 
# Examples:
#   MONDAY_FRIDAY=06:00-22:30    # 6:00 AM to 10:30 PM on weekdays
#   SATURDAY_SUNDAY=08:00-23:00  # 8:00 AM to 11:00 PM on weekends
#   MONDAY_FRIDAY=09:00-17:00    # Standard work hours
